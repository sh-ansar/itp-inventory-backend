APP_NAME="ITP Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=itp_inventory
DB_USERNAME=inventory_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=itp_inventory_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
INVENTORY_XSRF_COOKIE_NAME=INVENTORY-XSRF-TOKEN
SANCTUM_STATEFUL_DOMAINS=platform.itpmining.kz
INVENTORY_BROWSER_LOGIN_ENABLED=false
QUEUE_CONNECTION=database
CACHE_STORE=database